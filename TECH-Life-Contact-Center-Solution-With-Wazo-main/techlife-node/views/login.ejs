<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Sign in — TECH-Life Contact-Center Solution</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap">
<link rel="stylesheet" href="/assets/style.css"></head>
<body class="tl-login-page">
<div class="tl-login-box">
    <div class="tl-brand-mark">TL</div>
    <h1>TECH-Life</h1>
    <p class="tl-subtitle">Contact-Center Solution</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="tl-error"><%= error %></div><% } %>
    <form method="post" action="/login">
        <label>Admin / Username</label>
        <input type="text" name="username" required value="<%= typeof form !== 'undefined' ? form.username || '' : '' %>">
        <label>Password</label>
        <input type="password" name="password" required>
        <details>
            <summary>Sign-in options</summary>
            <label>Tenant slug (only if your username is used in more than one tenant)</label>
            <input type="text" name="tenant_slug" placeholder="e.g. acme" value="<%= typeof form !== 'undefined' ? form.tenant_slug || '' : '' %>">
        </details>
        <button class="tl-btn" type="submit">Sign in</button>
    </form>
    <div class="tl-role-hint">
        Sign in with your username and password. If the same username and password are used by
        accounts in multiple tenants, provide your tenant slug under sign-in options.
    </div>
</div>
</body></html>
