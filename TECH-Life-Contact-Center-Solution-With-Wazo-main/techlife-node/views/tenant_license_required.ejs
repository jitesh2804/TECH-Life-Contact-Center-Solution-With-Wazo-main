<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>License Required — TECH-Life</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body class="tl-login-page">
    <div class="tl-login-box">
        <div class="tl-brand-mark">TL</div>
        <h1>License required</h1>
        <p class="tl-subtitle">This tenant cannot access the system until a valid license is uploaded.</p>
        <div class="tl-error"><%= reason %></div>
        <div class="tl-role-hint">
            <% if (canManageLicense) { %>
                Upload or renew this tenant's signed license from the admin area.
            <% } else { %>
                Please contact your tenant administrator to upload or renew the license.
            <% } %>
        </div>
        <% if (canManageLicense) { %>
            <a class="tl-btn tl-btn-block" href="/admin/license">Go to license page</a>
        <% } %>
        <a class="tl-link" href="/logout">Log out</a>
    </div>
</body>
</html>
